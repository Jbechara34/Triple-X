# Optional overrides for docker-compose.yml. Copy to .env and adjust.
# None of these are required to get started - Settings are configured from
# the web UI instead (wallet address + pool mode), not from here.

# Block explorer used by the Blocks tab to let you verify payouts.
# Swap for an .onion explorer if you route this container's traffic through
# Tor - see README.md "Block explorer" section.
EXPLORER_BASE_URL=https://xmrchain.net
